# ==============================================================================
# CampusOS Environment Variables
# ==============================================================================
# Copy this file to .env.local and populate with your project credentials:
#   cp .env.example .env.local
#
# DO NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Public Configuration (Exposed to browser & server)
# ------------------------------------------------------------------------------
# Required for Supabase client connection (lib/supabase/client.ts, server.ts, proxy.ts).
# Obtain these from your Supabase project dashboard: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy anon key is supported as a fallback if your project has not issued a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Application URL Configuration
# ------------------------------------------------------------------------------
# The canonical base URL of the running application.
# Used for OAuth redirects and email verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep false until the Google provider is enabled in Supabase Auth and its
# OAuth client credentials are configured there.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
